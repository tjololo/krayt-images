# krayt-<variant>.yaml at the root are generated: krayt/base.yaml deep-merged with
# krayt/<variant>.yaml (maps merge, lists append). Edit those, then `make krayt`.
VARIANTS := $(filter-out base,$(basename $(notdir $(wildcard krayt/*.yaml))))
GEN_DIR :=
GENERATED := $(VARIANTS:%=krayt-%.yaml)

.PHONY: krayt check-krayt FORCE
krayt: $(addprefix $(GEN_DIR),$(GENERATED))

$(GEN_DIR)krayt-%.yaml: krayt/base.yaml krayt/%.yaml FORCE
	@{ echo '# GENERATED by `make krayt` from krayt/base.yaml + krayt/$*.yaml — do not edit.'; \
	  yq eval-all '. as $$i ireduce ({}; . *+ $$i)' krayt/base.yaml krayt/$*.yaml; } > $@
	@echo "wrote $@"

# Fails if a generated file was hand-edited or not regenerated after a krayt/ change. Renders to a
# temp dir and diffs, so it never touches the files it is checking.
check-krayt:
	@tmp=$$(mktemp -d "$${TMPDIR:-/tmp}/krayt.XXXXXX") && trap 'rm -rf "$$tmp"' EXIT && \
	$(MAKE) -s krayt GEN_DIR="$$tmp/" >/dev/null && \
	for f in $(GENERATED); do diff -u "$$f" "$$tmp/$$f" || exit 1; done

# Always regenerate: a hand-edited output is newer than its sources and would otherwise be skipped.
FORCE:
